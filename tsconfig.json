{
  "compilerOptions": {
    "target": "ES2020",               // Versión de JavaScript a la que se compilará
    "module": "commonjs",             // Sistema de módulos a usar
    "outDir": "./dist",               // Directorio de salida
    "rootDir": "./src",               // Directorio raíz de los archivos .ts
    "strict": true,                   // Habilita todas las comprobaciones estrictas de tipo
    "esModuleInterop": true,          // Permite la interoperabilidad con módulos CommonJS
    "skipLibCheck": true,             // Omite la comprobación de tipos de los archivos de declaración (.d.ts)
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],              // Incluye todos los archivos dentro de la carpeta src
  "exclude": ["node_modules", "**/*.spec.ts"] // Excluye la carpeta de módulos y archivos de prueba
}